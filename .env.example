# Required for NextAuth.js (JWT signing). Use: openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional: set NEXTAUTH_URL in production (e.g. https://yourdomain.com).
# Also used as the base for links in emails, alerts and audit share links.
NEXTAUTH_URL=https://kreatale.com

# Postgres connection string
DATABASE_URL=

# Images
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BLOB_READ_WRITE_TOKEN=

# Spam check on the contact form and the free website check (hCaptcha)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Email through Resend. Verify kreatale.com in Resend (SPF/DKIM/DMARC) first.
RESEND_API_KEY=
# team alerts and the daily digest
NOTIFY_EMAIL_FROM="Kreatale <alerts@kreatale.com>"
NOTIFY_EMAIL_TO=info@kreatale.com
# the instant reply to enquiries and the website-check report email
AUTO_REPLY_FROM="Kreatale <info@kreatale.com>"
AUTO_REPLY_REPLY_TO=info@kreatale.com

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Weekday digest + recovering stuck audits. Generate with: openssl rand -hex 32
# Dokploy > Schedules, cron "0 0 * * 1-5" (08:00 in Bali/Makassar), command:
#   node -e "fetch('http://localhost:3000/api/cron/digest',{method:'POST',headers:{authorization:'Bearer '+process.env.CRON_SECRET}}).then(r=>process.exit(r.ok?0:1))"
CRON_SECRET=
# time zone for "today" in the pipeline and dashboard
PIPELINE_TZ=Asia/Makassar

# Free website check. A Google PageSpeed Insights API key is needed in practice:
# the keyless quota is shared and usually used up. Free from Google Cloud Console
# (enable "PageSpeed Insights API", create an API key, restrict it to that API).
PAGESPEED_API_KEY=
# max public checks per 24 hours
AUDIT_DAILY_LIMIT=100

# Morpheus admin (Admin > Morpheus). The core API base URL, no trailing slash,
# and the same value as Morpheus's ADMIN_API_TOKEN. Generate with: openssl rand -hex 32
MORPHEUS_API_URL=
MORPHEUS_ADMIN_TOKEN=
